import 'package:flutter/material.dart';

import '../widgets/premium_background.dart';
import '../services/local_storage_service.dart';

class AiScreen extends StatefulWidget {
  const AiScreen({super.key});

  @override
  State<AiScreen> createState() => _AiScreenState();
}

class _AiScreenState extends State<AiScreen> {
  final TextEditingController _controller = TextEditingController();
  final ScrollController _scrollController = ScrollController();

  final List<_ChatMessage> _messages = [
    const _ChatMessage(
      text:
          'Namaste! I’m Jeevan Sutra AI. Ask me about traditional knowledge, routines, plants, food, yoga, or mindful living.',
      isUser: false,
    ),
  ];

  final List<String> _suggestions = [
    'What is Dinacharya?',
    'Tell me about Tulsi',
    'What is Ritucharya?',
    'How can I practise mindfulness?',
  ];

  bool _isThinking = false;
  bool _historyLoaded = false;

  @override
  void initState() {
    super.initState();
    _loadChatHistory();
  }

  Future<void> _loadChatHistory() async {
    final saved = await LocalStorageService.instance.getChatHistory();
    if (!mounted) return;
    if (saved.isNotEmpty) {
      setState(() {
        _messages
          ..clear()
          ..addAll(saved.map((item) => _ChatMessage(
                text: (item['text'] ?? '').toString(),
                isUser: item['isUser'] == true,
              )));
        _historyLoaded = true;
      });
    } else {
      setState(() => _historyLoaded = true);
    }
  }

  Future<void> _persistChat() async {
    if (!_historyLoaded) return;
    await LocalStorageService.instance.saveChatHistory(_messages.map((message) => <String, dynamic>{'text': message.text, 'isUser': message.isUser}).toList());
  }

  @override
  void dispose() {
    _controller.dispose();
    _scrollController.dispose();
    super.dispose();
  }

  Future<void> _sendMessage([String? suggestedText]) async {
    final text = (suggestedText ?? _controller.text).trim();

    if (text.isEmpty || _isThinking) {
      return;
    }

    setState(() {
      _messages.add(
        _ChatMessage(
          text: text,
          isUser: true,
        ),
      );

      _isThinking = true;
    });

    _controller.clear();
    await _persistChat();

    await _scrollToBottom();

    await Future<void>.delayed(
      const Duration(milliseconds: 700),
    );

    if (!mounted) {
      return;
    }

    setState(() {
      _messages.add(
        _ChatMessage(
          text: _demoResponse(text),
          isUser: false,
        ),
      );

      _isThinking = false;
    });

    await _persistChat();
    await _scrollToBottom();
  }

  String _demoResponse(String question) {
    final q = question.toLowerCase();

    if (q.contains('dinacharya')) {
      return 'Dinacharya is a traditional concept centred around creating a consistent daily rhythm. In Jeevan Sutra, you can explore it through morning, daytime, evening, and night routines.';
    }

    if (q.contains('tulsi')) {
      return 'Tulsi, commonly known as holy basil, is a plant with an important place in Indian cultural and traditional practices. Use the Plant Knowledge section to learn more.';
    }

    if (q.contains('ritucharya')) {
      return 'Ritucharya describes the idea of adapting aspects of daily life with seasonal changes. Our Ritucharya section explains this concept in a simple way.';
    }

    if (q.contains('mindfulness') || q.contains('meditation')) {
      return 'Mindfulness means paying attention to the present moment with awareness. You can start with a few quiet minutes of comfortable breathing and observation.';
    }

    if (q.contains('plant')) {
      return 'You can use the Plant Scanner to select a plant photo. The current version can preview your image; full plant identification will be connected later through a secure recognition service.';
    }

    return 'That’s an interesting question. I’m currently running in demo mode, so my responses are limited. The Jeevan Sutra AI service can be connected later for real-time answers.';
  }

  Future<void> _scrollToBottom() async {
    await Future<void>.delayed(const Duration(milliseconds: 80));

    if (!_scrollController.hasClients) {
      return;
    }

    await _scrollController.animateTo(
      _scrollController.position.maxScrollExtent,
      duration: const Duration(milliseconds: 280),
      curve: Curves.easeOut,
    );
  }

  void _clearChat() {
    setState(() {
      _messages
        ..clear()
        ..add(
          const _ChatMessage(
            text:
                'Namaste! I’m Jeevan Sutra AI. Ask me about traditional knowledge, routines, plants, food, yoga, or mindful living.',
            isUser: false,
          ),
        );

      _isThinking = false;
    });

    _persistChat();
    _scrollToBottom();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.transparent,
      body: PremiumBackground(
        child: SafeArea(
          child: Column(
            children: [
              // Header
              Padding(
                padding: const EdgeInsets.fromLTRB(20, 18, 20, 14),
                child: Row(
                  children: [
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            'Your personal guide',
                            style: TextStyle(
                              fontSize: 13,
                              fontWeight: FontWeight.w700,
                              color: Colors.grey.shade600,
                            ),
                          ),
                          const SizedBox(height: 4),
                          const Text(
                            'AI Assistant',
                            style: TextStyle(
                              fontSize: 28,
                              fontWeight: FontWeight.w800,
                              color: Color(0xFF183B2A),
                            ),
                          ),
                        ],
                      ),
                    ),
                    IconButton(
                      tooltip: 'Clear conversation',
                      onPressed: _clearChat,
                      icon: Container(
                        width: 46,
                        height: 46,
                        decoration: BoxDecoration(
                          gradient: const LinearGradient(
                            colors: [
                              Color(0xFFE8D7AE),
                              Color(0xFFF3E9D0),
                            ],
                          ),
                          borderRadius: BorderRadius.circular(15),
                          border: Border.all(
                            color: const Color(0xFFB89452)
                                .withValues(alpha: 0.22),
                          ),
                        ),
                        child: const Icon(
                          Icons.refresh_rounded,
                          color: Color(0xFF8A632F),
                          size: 23,
                        ),
                      ),
                    ),
                  ],
                ),
              ),

              // AI identity card
              Padding(
                padding: const EdgeInsets.symmetric(horizontal: 20),
                child: Container(
                  width: double.infinity,
                  padding: const EdgeInsets.all(18),
                  decoration: BoxDecoration(
                    gradient: const LinearGradient(
                      colors: [
                        Color(0xFF183B2A),
                        Color(0xFF2F6B4F),
                        Color(0xFF587F69),
                      ],
                      begin: Alignment.topLeft,
                      end: Alignment.bottomRight,
                    ),
                    borderRadius: BorderRadius.circular(23),
                    border: Border.all(
                      color: const Color(0xFFB89452).withValues(alpha: 0.24),
                    ),
                    boxShadow: [
                      BoxShadow(
                        color: const Color(0xFF183B2A).withValues(alpha: 0.13),
                        blurRadius: 18,
                        offset: const Offset(0, 7),
                      ),
                    ],
                  ),
                  child: Row(
                    children: [
                      Container(
                        width: 54,
                        height: 54,
                        decoration: BoxDecoration(
                          color: const Color(0xFFF0E1BD).withValues(alpha: 0.16),
                          borderRadius: BorderRadius.circular(17),
                          border: Border.all(
                            color:
                                const Color(0xFFE5CF98).withValues(alpha: 0.18),
                          ),
                        ),
                        child: const Icon(
                          Icons.auto_awesome_rounded,
                          color: Color(0xFFF0E1BD),
                          size: 28,
                        ),
                      ),
                      const SizedBox(width: 14),
                      const Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Text(
                              'Jeevan Sutra AI',
                              style: TextStyle(
                                color: Colors.white,
                                fontSize: 15,
                                fontWeight: FontWeight.w800,
                              ),
                            ),
                            SizedBox(height: 4),
                            Text(
                              'Learn • Explore • Understand',
                              style: TextStyle(
                                color: Colors.white70,
                                fontSize: 11.5,
                              ),
                            ),
                          ],
                        ),
                      ),
                      Container(
                        padding: const EdgeInsets.symmetric(
                          horizontal: 9,
                          vertical: 6,
                        ),
                        decoration: BoxDecoration(
                          color: const Color(0xFFF0E1BD).withValues(alpha: 0.12),
                          borderRadius: BorderRadius.circular(20),
                        ),
                        child: const Text(
                          'DEMO',
                          style: TextStyle(
                            color: Color(0xFFF0E1BD),
                            fontSize: 9,
                            fontWeight: FontWeight.w800,
                            letterSpacing: 0.8,
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ),

              const SizedBox(height: 14),

              // Chat
              Expanded(
                child: ListView.builder(
                  controller: _scrollController,
                  padding: const EdgeInsets.fromLTRB(20, 5, 20, 12),
                  itemCount: _messages.length + (_isThinking ? 1 : 0),
                  itemBuilder: (context, index) {
                    if (_isThinking && index == _messages.length) {
                      return const _TypingBubble();
                    }

                    final message = _messages[index];

                    return _ChatBubble(
                      message: message.text,
                      isUser: message.isUser,
                    );
                  },
                ),
              ),

              // Suggestions
              SizedBox(
                height: 45,
                child: ListView.separated(
                  padding: const EdgeInsets.symmetric(horizontal: 20),
                  scrollDirection: Axis.horizontal,
                  itemCount: _suggestions.length,
                  separatorBuilder: (_, index) {
                    return const SizedBox(width: 9);
                  },
                  itemBuilder: (context, index) {
                    return Material(
                      color: Colors.transparent,
                      child: InkWell(
                        onTap: () => _sendMessage(_suggestions[index]),
                        borderRadius: BorderRadius.circular(22),
                        child: Container(
                          padding: const EdgeInsets.symmetric(
                            horizontal: 14,
                            vertical: 10,
                          ),
                          decoration: BoxDecoration(
                            color: Colors.white.withValues(alpha: 0.90),
                            borderRadius: BorderRadius.circular(22),
                            border: Border.all(
                              color: const Color(0xFFB89452)
                                  .withValues(alpha: 0.14),
                            ),
                          ),
                          child: Text(
                            _suggestions[index],
                            style: const TextStyle(
                              color: Color(0xFF31523F),
                              fontSize: 11.5,
                              fontWeight: FontWeight.w700,
                            ),
                          ),
                        ),
                      ),
                    );
                  },
                ),
              ),

              const SizedBox(height: 10),

              // Input
              Padding(
                padding: const EdgeInsets.fromLTRB(20, 0, 20, 18),
                child: Container(
                  padding: const EdgeInsets.only(
                    left: 16,
                    right: 8,
                    top: 6,
                    bottom: 6,
                  ),
                  decoration: BoxDecoration(
                    color: Colors.white.withValues(alpha: 0.95),
                    borderRadius: BorderRadius.circular(20),
                    border: Border.all(
                      color: const Color(0xFFB89452).withValues(alpha: 0.15),
                    ),
                    boxShadow: [
                      BoxShadow(
                        color: Colors.black.withValues(alpha: 0.04),
                        blurRadius: 14,
                        offset: const Offset(0, 5),
                      ),
                    ],
                  ),
                  child: Row(
                    children: [
                      const Icon(
                        Icons.chat_bubble_outline_rounded,
                        color: Color(0xFF8A9A90),
                        size: 21,
                      ),
                      const SizedBox(width: 10),
                      Expanded(
                        child: TextField(
                          controller: _controller,
                          enabled: !_isThinking,
                          textInputAction: TextInputAction.send,
                          onSubmitted: (_) => _sendMessage(),
                          decoration: const InputDecoration(
                            hintText: 'Ask Jeevan Sutra...',
                            border: InputBorder.none,
                          ),
                        ),
                      ),
                      AnimatedContainer(
                        duration: const Duration(milliseconds: 180),
                        decoration: BoxDecoration(
                          color: _isThinking
                              ? const Color(0xFF9AA9A0)
                              : const Color(0xFF2F6B4F),
                          borderRadius: BorderRadius.circular(14),
                        ),
                        child: InkWell(
                          onTap: _isThinking ? null : _sendMessage,
                          borderRadius: BorderRadius.circular(14),
                          child: Padding(
                            padding: const EdgeInsets.all(11),
                            child: _isThinking
                                ? const SizedBox(
                                    width: 20,
                                    height: 20,
                                    child: CircularProgressIndicator(
                                      strokeWidth: 2,
                                      valueColor:
                                          AlwaysStoppedAnimation<Color>(
                                        Colors.white,
                                      ),
                                    ),
                                  )
                                : const Icon(
                                    Icons.arrow_upward_rounded,
                                    color: Colors.white,
                                    size: 20,
                                  ),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _ChatMessage {
  final String text;
  final bool isUser;

  const _ChatMessage({
    required this.text,
    required this.isUser,
  });
}

class _ChatBubble extends StatelessWidget {
  final String message;
  final bool isUser;

  const _ChatBubble({
    required this.message,
    required this.isUser,
  });

  @override
  Widget build(BuildContext context) {
    return Align(
      alignment:
          isUser ? Alignment.centerRight : Alignment.centerLeft,
      child: Container(
        constraints: const BoxConstraints(
          maxWidth: 560,
        ),
        margin: const EdgeInsets.only(bottom: 12),
        padding: const EdgeInsets.all(15),
        decoration: BoxDecoration(
          color: isUser
              ? const Color(0xFF2F6B4F)
              : Colors.white.withValues(alpha: 0.91),
          borderRadius: BorderRadius.only(
            topLeft: const Radius.circular(18),
            topRight: const Radius.circular(18),
            bottomLeft: Radius.circular(isUser ? 18 : 5),
            bottomRight: Radius.circular(isUser ? 5 : 18),
          ),
          border: Border.all(
            color: isUser
                ? const Color(0xFF2F6B4F)
                : const Color(0xFFB89452).withValues(alpha: 0.10),
          ),
          boxShadow: [
            BoxShadow(
              color: Colors.black.withValues(alpha: 0.025),
              blurRadius: 10,
              offset: const Offset(0, 4),
            ),
          ],
        ),
        child: Column(
          crossAxisAlignment:
              isUser ? CrossAxisAlignment.end : CrossAxisAlignment.start,
          children: [
            Text(
              message,
              style: TextStyle(
                color: isUser
                    ? Colors.white
                    : const Color(0xFF31523F),
                fontSize: 13,
                height: 1.45,
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _TypingBubble extends StatelessWidget {
  const _TypingBubble();

  @override
  Widget build(BuildContext context) {
    return Align(
      alignment: Alignment.centerLeft,
      child: Container(
        margin: const EdgeInsets.only(bottom: 12),
        padding: const EdgeInsets.symmetric(
          horizontal: 17,
          vertical: 14,
        ),
        decoration: BoxDecoration(
          color: Colors.white.withValues(alpha: 0.91),
          borderRadius: const BorderRadius.only(
            topLeft: Radius.circular(18),
            topRight: Radius.circular(18),
            bottomRight: Radius.circular(18),
            bottomLeft: Radius.circular(5),
          ),
          border: Border.all(
            color: const Color(0xFFB89452).withValues(alpha: 0.10),
          ),
        ),
        child: const Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            _Dot(),
            SizedBox(width: 4),
            _Dot(),
            SizedBox(width: 4),
            _Dot(),
          ],
        ),
      ),
    );
  }
}

class _Dot extends StatelessWidget {
  const _Dot();

  @override
  Widget build(BuildContext context) {
    return Container(
      width: 6,
      height: 6,
      decoration: const BoxDecoration(
        color: Color(0xFF6E987F),
        shape: BoxShape.circle,
      ),
    );
  }
}