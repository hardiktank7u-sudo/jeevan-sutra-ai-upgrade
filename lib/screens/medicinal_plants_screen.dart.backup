import 'package:flutter/material.dart';

import '../models/plant.dart';
import '../repositories/content_repository.dart';
import '../services/local_storage_service.dart';
import '../widgets/premium_background.dart';
import 'plant_detail_screen.dart';

class MedicinalPlantsScreen extends StatefulWidget {
  const MedicinalPlantsScreen({super.key});

  @override
  State<MedicinalPlantsScreen> createState() => _MedicinalPlantsScreenState();
}

class _MedicinalPlantsScreenState extends State<MedicinalPlantsScreen> {
  final LocalStorageService _storage = LocalStorageService.instance;

  Set<String> _savedPlants = <String>{};
  List<Plant> _plants = <Plant>[];
  bool _loading = true;
  String? _error;

  @override
  void initState() {
    super.initState();
    _loadContent();
  }

  Future<void> _loadContent() async {
    try {
      final results = await Future.wait([
        _storage.getSavedPlants(),
        ContentRepository.loadPlants(),
      ]);

      if (!mounted) {
        return;
      }

      setState(() {
        _savedPlants = (results[0] as List<String>).toSet();
        _plants = results[1] as List<Plant>;
        _loading = false;
        _error = null;
      });
    } on Object catch (error) {
      if (!mounted) {
        return;
      }

      setState(() {
        _loading = false;
        _error = 'Unable to load plant knowledge.';
      });

      debugPrint('MedicinalPlantsScreen error: $error');
    }
  }

  Future<void> _togglePlant(Plant plant) async {
    await _storage.toggleSavedPlant(plant.commonName);

    if (!mounted) {
      return;
    }

    setState(() {
      if (_savedPlants.contains(plant.commonName)) {
        _savedPlants.remove(plant.commonName);
      } else {
        _savedPlants.add(plant.commonName);
      }
    });

    final saved = _savedPlants.contains(plant.commonName);

    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(
        SnackBar(
          duration: const Duration(milliseconds: 1400),
          behavior: SnackBarBehavior.floating,
          content: Text(
            saved
                ? '${plant.commonName} saved to your plants'
                : '${plant.commonName} removed from saved plants',
          ),
        ),
      );
  }

  void _openPlant(Plant plant) {
    Navigator.of(context).push(
      MaterialPageRoute<void>(
        builder: (_) => PlantDetailScreen(plant: plant),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.transparent,
      body: PremiumBackground(
        child: SafeArea(
          child: SingleChildScrollView(
            padding: const EdgeInsets.fromLTRB(20, 18, 20, 32),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            'Nature in your hands',
                            style: TextStyle(
                              fontSize: 13,
                              fontWeight: FontWeight.w700,
                              color: Colors.grey.shade600,
                            ),
                          ),
                          const SizedBox(height: 4),
                          const Text(
                            'Medicinal Plants',
                            style: TextStyle(
                              fontSize: 29,
                              fontWeight: FontWeight.w800,
                              color: Color(0xFF183B2A),
                            ),
                          ),
                        ],
                      ),
                    ),
                    Container(
                      width: 50,
                      height: 50,
                      decoration: BoxDecoration(
                        gradient: const LinearGradient(
                          colors: [
                            Color(0xFFE2EBD8),
                            Color(0xFFF0EAD9),
                          ],
                        ),
                        borderRadius: BorderRadius.circular(17),
                        border: Border.all(
                          color: const Color(0xFFB89452).withValues(
                            alpha: 0.24,
                          ),
                        ),
                      ),
                      child: const Icon(
                        Icons.local_florist_rounded,
                        color: Color(0xFF2F6B4F),
                        size: 26,
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 24),
                Container(
                  width: double.infinity,
                  padding: const EdgeInsets.all(24),
                  decoration: BoxDecoration(
                    gradient: const LinearGradient(
                      colors: [
                        Color(0xFF183B2A),
                        Color(0xFF2F6B4F),
                        Color(0xFF6B977C),
                      ],
                      begin: Alignment.topLeft,
                      end: Alignment.bottomRight,
                    ),
                    borderRadius: BorderRadius.circular(28),
                    border: Border.all(
                      color: const Color(0xFFB89452).withValues(
                        alpha: 0.27,
                      ),
                    ),
                    boxShadow: [
                      BoxShadow(
                        color: const Color(0xFF183B2A).withValues(
                          alpha: 0.17,
                        ),
                        blurRadius: 23,
                        offset: const Offset(0, 10),
                      ),
                    ],
                  ),
                  child: Stack(
                    children: [
                      Positioned(
                        right: -30,
                        top: -30,
                        child: Container(
                          width: 135,
                          height: 135,
                          decoration: BoxDecoration(
                            shape: BoxShape.circle,
                            border: Border.all(
                              color: const Color(0xFFE5CF98).withValues(
                                alpha: 0.12,
                              ),
                              width: 1.4,
                            ),
                          ),
                        ),
                      ),
                      Positioned(
                        right: 8,
                        top: 15,
                        child: Icon(
                          Icons.eco_rounded,
                          size: 88,
                          color: const Color(0xFFE5CF98).withValues(
                            alpha: 0.08,
                          ),
                        ),
                      ),
                      Positioned(
                        right: -4,
                        bottom: -28,
                        child: Icon(
                          Icons.spa_rounded,
                          size: 90,
                          color: Colors.white.withValues(
                            alpha: 0.06,
                          ),
                        ),
                      ),
                      Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Container(
                            padding: const EdgeInsets.symmetric(
                              horizontal: 11,
                              vertical: 6,
                            ),
                            decoration: BoxDecoration(
                              color: const Color(0xFFB89452).withValues(
                                alpha: 0.16,
                              ),
                              borderRadius: BorderRadius.circular(30),
                              border: Border.all(
                                color: const Color(0xFFE5CF98).withValues(
                                  alpha: 0.20,
                                ),
                              ),
                            ),
                            child: const Text(
                              'PLANT KNOWLEDGE',
                              style: TextStyle(
                                color: Color(0xFFF3E8CD),
                                fontSize: 10.5,
                                fontWeight: FontWeight.w800,
                                letterSpacing: 1.1,
                              ),
                            ),
                          ),
                          const SizedBox(height: 18),
                          const Text(
                            'Discover the\nwisdom of plants.',
                            style: TextStyle(
                              color: Colors.white,
                              fontSize: 29,
                              height: 1.12,
                              fontWeight: FontWeight.w800,
                            ),
                          ),
                          const SizedBox(height: 10),
                          Text(
                            'Explore educational information about familiar plants and their traditional uses.',
                            style: TextStyle(
                              color: Colors.white.withValues(
                                alpha: 0.84,
                              ),
                              fontSize: 13.5,
                              height: 1.5,
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 28),
                Row(
                  children: [
                    const Expanded(
                      child: Text(
                        'Featured plants',
                        style: TextStyle(
                          fontSize: 22,
                          fontWeight: FontWeight.w800,
                          color: Color(0xFF183B2A),
                        ),
                      ),
                    ),
                    if (!_loading && _savedPlants.isNotEmpty)
                      Container(
                        padding: const EdgeInsets.symmetric(
                          horizontal: 10,
                          vertical: 6,
                        ),
                        decoration: BoxDecoration(
                          color: const Color(0xFFE7F0EA),
                          borderRadius: BorderRadius.circular(20),
                        ),
                        child: Text(
                          '${_savedPlants.length} saved',
                          style: const TextStyle(
                            color: Color(0xFF2F6B4F),
                            fontSize: 10.5,
                            fontWeight: FontWeight.w800,
                          ),
                        ),
                      ),
                  ],
                ),
                const SizedBox(height: 8),
                Text(
                  'Learn about commonly known plants through a cultural and educational lens.',
                  style: TextStyle(
                    fontSize: 13,
                    height: 1.45,
                    color: Colors.grey.shade600,
                  ),
                ),
                const SizedBox(height: 17),
                if (_loading)
                  const Center(
                    child: Padding(
                      padding: EdgeInsets.symmetric(vertical: 35),
                      child: CircularProgressIndicator(
                        color: Color(0xFF2F6B4F),
                      ),
                    ),
                  )
                else if (_error != null)
                  _ErrorCard(
                    message: _error!,
                    onRetry: _loadContent,
                  )
                else if (_plants.isEmpty)
                  const _EmptyPlantsCard()
                else
                  ..._plants.map(
                    (plant) => _PlantCard(
                      plant: plant,
                      saved: _savedPlants.contains(plant.commonName),
                      onOpen: () => _openPlant(plant),
                      onSave: () => _togglePlant(plant),
                    ),
                  ),
                const SizedBox(height: 16),
                const Text(
                  'Explore plant knowledge',
                  style: TextStyle(
                    fontSize: 22,
                    fontWeight: FontWeight.w800,
                    color: Color(0xFF183B2A),
                  ),
                ),
                const SizedBox(height: 14),
                const _KnowledgeRow(
                  icon: Icons.history_edu_rounded,
                  title: 'Traditional knowledge',
                  subtitle:
                      'Understand how plants have been used across generations.',
                ),
                const _KnowledgeRow(
                  icon: Icons.search_rounded,
                  title: 'Learn and compare',
                  subtitle:
                      'Explore names, characteristics, and cultural context.',
                ),
                const _KnowledgeRow(
                  icon: Icons.menu_book_rounded,
                  title: 'Keep learning',
                  subtitle:
                      'Use the library to explore more plant-related topics.',
                ),
                const SizedBox(height: 12),
                Container(
                  padding: const EdgeInsets.all(18),
                  decoration: BoxDecoration(
                    gradient: LinearGradient(
                      colors: [
                        const Color(0xFFE7F0EA),
                        const Color(0xFFF0EAD9).withValues(
                          alpha: 0.78,
                        ),
                      ],
                    ),
                    borderRadius: BorderRadius.circular(21),
                    border: Border.all(
                      color: const Color(0xFFB89452).withValues(
                        alpha: 0.11,
                      ),
                    ),
                  ),
                  child: const Row(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Icon(
                        Icons.info_outline_rounded,
                        color: Color(0xFF8A632F),
                      ),
                      SizedBox(width: 12),
                      Expanded(
                        child: Text(
                          'Plant information in Jeevan Sutra is for education and exploration. Do not use a plant as a treatment without checking its safety and suitability with a qualified professional.',
                          style: TextStyle(
                            fontSize: 12.5,
                            height: 1.45,
                            color: Color(0xFF5E6A62),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

class _PlantCard extends StatelessWidget {
  final Plant plant;
  final bool saved;
  final VoidCallback onOpen;
  final VoidCallback onSave;

  const _PlantCard({
    required this.plant,
    required this.saved,
    required this.onOpen,
    required this.onSave,
  });

  Color get _accent {
    switch (plant.id) {
      case 'tulsi':
        return const Color(0xFF2F6B4F);
      case 'neem':
        return const Color(0xFF3C7A55);
      case 'aloe_vera':
        return const Color(0xFF5D8EA4);
      case 'ashwagandha':
        return const Color(0xFF8A632F);
      case 'turmeric':
        return const Color(0xFFB8862D);
      default:
        return const Color(0xFF2F6B4F);
    }
  }

  IconData get _icon {
    switch (plant.id) {
      case 'tulsi':
        return Icons.eco_rounded;
      case 'neem':
        return Icons.spa_rounded;
      case 'aloe_vera':
        return Icons.grass_rounded;
      case 'ashwagandha':
        return Icons.local_florist_rounded;
      case 'turmeric':
        return Icons.grass_rounded;
      default:
        return Icons.local_florist_rounded;
    }
  }

  String get _description {
    if (plant.identification.trim().isNotEmpty) {
      return plant.identification;
    }

    if (plant.traditionalUses.isNotEmpty) {
      return plant.traditionalUses.first;
    }

    return 'Educational information about this plant is being prepared and reviewed.';
  }

  @override
  Widget build(BuildContext context) {
    return Container(
      margin: const EdgeInsets.only(bottom: 12),
      decoration: BoxDecoration(
        color: Colors.white.withValues(alpha: 0.90),
        borderRadius: BorderRadius.circular(21),
        border: Border.all(
          color: saved
              ? const Color(0xFFB89452).withValues(alpha: 0.28)
              : _accent.withValues(alpha: 0.13),
        ),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.03),
            blurRadius: 11,
            offset: const Offset(0, 5),
          ),
        ],
      ),
      child: Material(
        color: Colors.transparent,
        borderRadius: BorderRadius.circular(21),
        child: InkWell(
          onTap: onOpen,
          borderRadius: BorderRadius.circular(21),
          child: Padding(
            padding: const EdgeInsets.all(17),
            child: Row(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Container(
                  width: 50,
                  height: 50,
                  decoration: BoxDecoration(
                    color: _accent.withValues(alpha: 0.12),
                    borderRadius: BorderRadius.circular(15),
                  ),
                  child: Icon(
                    _icon,
                    color: _accent,
                    size: 25,
                  ),
                ),
                const SizedBox(width: 13),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        plant.commonName,
                        style: const TextStyle(
                          fontSize: 16,
                          fontWeight: FontWeight.w800,
                          color: Color(0xFF183B2A),
                        ),
                      ),
                      const SizedBox(height: 3),
                      Text(
                        plant.scientificName,
                        style: TextStyle(
                          fontSize: 11.5,
                          fontStyle: FontStyle.italic,
                          color: _accent,
                        ),
                      ),
                      const SizedBox(height: 6),
                      Text(
                        _description,
                        style: TextStyle(
                          fontSize: 12.5,
                          height: 1.45,
                          color: Colors.grey.shade600,
                        ),
                      ),
                      const SizedBox(height: 9),
                      Row(
                        children: [
                          Icon(
                            Icons.arrow_forward_rounded,
                            size: 15,
                            color: _accent,
                          ),
                          const SizedBox(width: 5),
                          Text(
                            'View plant details',
                            style: TextStyle(
                              fontSize: 11.5,
                              fontWeight: FontWeight.w800,
                              color: _accent,
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),
                const SizedBox(width: 8),
                Material(
                  color: Colors.transparent,
                  child: InkWell(
                    onTap: onSave,
                    borderRadius: BorderRadius.circular(14),
                    child: AnimatedContainer(
                      duration: const Duration(milliseconds: 200),
                      width: 42,
                      height: 42,
                      decoration: BoxDecoration(
                        color: saved
                            ? const Color(0xFFE9D9B3)
                            : const Color(0xFFF1F3EF),
                        borderRadius: BorderRadius.circular(14),
                      ),
                      child: AnimatedSwitcher(
                        duration: const Duration(milliseconds: 180),
                        child: Icon(
                          saved
                              ? Icons.bookmark_rounded
                              : Icons.bookmark_border_rounded,
                          key: ValueKey<bool>(saved),
                          color: saved
                              ? const Color(0xFF8A632F)
                              : const Color(0xFF6F7D74),
                          size: 21,
                        ),
                      ),
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

class _KnowledgeRow extends StatelessWidget {
  final IconData icon;
  final String title;
  final String subtitle;

  const _KnowledgeRow({
    required this.icon,
    required this.title,
    required this.subtitle,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      margin: const EdgeInsets.only(bottom: 11),
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.white.withValues(alpha: 0.88),
        borderRadius: BorderRadius.circular(19),
        border: Border.all(
          color: const Color(0xFFB89452).withValues(alpha: 0.09),
        ),
      ),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Container(
            width: 43,
            height: 43,
            decoration: BoxDecoration(
              color: const Color(0xFFE5F0E9),
              borderRadius: BorderRadius.circular(13),
            ),
            child: Icon(
              icon,
              color: const Color(0xFF2F6B4F),
              size: 21,
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  title,
                  style: const TextStyle(
                    fontSize: 14,
                    fontWeight: FontWeight.w800,
                    color: Color(0xFF183B2A),
                  ),
                ),
                const SizedBox(height: 4),
                Text(
                  subtitle,
                  style: TextStyle(
                    fontSize: 11.5,
                    height: 1.4,
                    color: Colors.grey.shade600,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}

class _ErrorCard extends StatelessWidget {
  final String message;
  final VoidCallback onRetry;

  const _ErrorCard({
    required this.message,
    required this.onRetry,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(20),
      decoration: BoxDecoration(
        color: Colors.white.withValues(alpha: 0.90),
        borderRadius: BorderRadius.circular(21),
      ),
      child: Column(
        children: [
          const Icon(
            Icons.error_outline_rounded,
            color: Color(0xFF8A632F),
            size: 32,
          ),
          const SizedBox(height: 10),
          Text(
            message,
            textAlign: TextAlign.center,
            style: const TextStyle(
              color: Color(0xFF183B2A),
              fontWeight: FontWeight.w700,
            ),
          ),
          const SizedBox(height: 12),
          TextButton(
            onPressed: onRetry,
            child: const Text('Try again'),
          ),
        ],
      ),
    );
  }
}

class _EmptyPlantsCard extends StatelessWidget {
  const _EmptyPlantsCard();

  @override
