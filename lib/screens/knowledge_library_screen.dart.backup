                          color: Color(0xFF183B2A),
                        ),
                      ),
                    ),
                    if (!_loading && _savedWisdom.isNotEmpty)
                      Container(
                        padding: const EdgeInsets.symmetric(
                          horizontal: 10,
                          vertical: 6,
                        ),
                        decoration: BoxDecoration(
                          color: const Color(0xFFE7F0EA),
                          borderRadius: BorderRadius.circular(20),
                        ),
                        child: Text(
                          '${_savedWisdom.length} saved',
                          style: const TextStyle(
                            color: Color(0xFF2F6B4F),
                            fontSize: 10.5,
                            fontWeight: FontWeight.w800,
                          ),
                        ),
                      ),
                  ],
                ),

                const SizedBox(height: 14),

                _ReadingCard(
                  icon: Icons.wb_sunny_rounded,
                  label: 'DAILY LIFE',
                  title: 'Understanding Dinacharya',
                  description:
                      'Explore the idea of creating a mindful and consistent daily rhythm.',
                  accent: const Color(0xFFB07832),
                  saved: _savedWisdom.contains('Understanding Dinacharya'),
                  onSave: () => _toggleWisdom('Understanding Dinacharya'),
                ),

                _ReadingCard(
                  icon: Icons.cloud_rounded,
                  label: 'SEASONS',
                  title: 'Understanding Ritucharya',
                  description:
                      'Discover the concept of adapting everyday habits with seasonal changes.',
                  accent: const Color(0xFF547A9A),
                  saved: _savedWisdom.contains('Understanding Ritucharya'),
                  onSave: () => _toggleWisdom('Understanding Ritucharya'),
                ),

                _ReadingCard(
                  icon: Icons.local_florist_rounded,
                  label: 'NATURE',
                  title: 'Traditional Plant Knowledge',
                  description:
                      'Learn how plants have been understood and used across generations.',
                  accent: const Color(0xFF3C7A55),
                  saved: _savedWisdom.contains('Traditional Plant Knowledge'),
                  onSave: () =>
                      _toggleWisdom('Traditional Plant Knowledge'),
                ),

                const SizedBox(height: 16),

                const Text(
                  'A library for curiosity',
                  style: TextStyle(
                    fontSize: 22,
                    fontWeight: FontWeight.w800,
                    color: Color(0xFF183B2A),
                  ),
                ),

                const SizedBox(height: 14),

                Container(
                  padding: const EdgeInsets.all(19),
                  decoration: BoxDecoration(
                    color: Colors.white.withValues(alpha: 0.90),
                    borderRadius: BorderRadius.circular(23),
                    border: Border.all(
                      color: const Color(0xFFB89452).withValues(
                        alpha: 0.10,
                      ),
                    ),
                    boxShadow: [
                      BoxShadow(
                        color: Colors.black.withValues(
                          alpha: 0.035,
                        ),
                        blurRadius: 14,
                        offset: const Offset(0, 6),
                      ),
                    ],
                  ),
                  child: const Column(
                    children: [
                      _LibraryTip(
                        icon: Icons.search_rounded,
                        title: 'Stay curious',
