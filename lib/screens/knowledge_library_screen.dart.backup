import 'package:flutter/material.dart';

import '../services/local_storage_service.dart';
import '../widgets/premium_background.dart';

class KnowledgeLibraryScreen extends StatefulWidget {
  const KnowledgeLibraryScreen({super.key});

  @override
  State<KnowledgeLibraryScreen> createState() => _KnowledgeLibraryScreenState();
}

class _KnowledgeLibraryScreenState extends State<KnowledgeLibraryScreen> {
  final LocalStorageService _storage = LocalStorageService.instance;

  Set<String> _savedWisdom = <String>{};
  bool _loading = true;

  @override
  void initState() {
    super.initState();
    _loadSavedWisdom();
  }

  Future<void> _loadSavedWisdom() async {
    final items = await _storage.getSavedWisdom();

    if (!mounted) {
      return;
    }

    setState(() {
      _savedWisdom = items.toSet();
      _loading = false;
    });
  }

  Future<void> _toggleWisdom(String title) async {
    await _storage.toggleSavedWisdom(title);

    if (!mounted) {
      return;
    }

    setState(() {
      if (_savedWisdom.contains(title)) {
        _savedWisdom.remove(title);
      } else {
        _savedWisdom.add(title);
      }
    });

    final saved = _savedWisdom.contains(title);

    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(
        SnackBar(
          duration: const Duration(milliseconds: 1400),
          behavior: SnackBarBehavior.floating,
          content: Text(
            saved ? 'Saved to your wisdom collection' : 'Removed from saved wisdom',
          ),
        ),
      );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.transparent,
      body: PremiumBackground(
        child: SafeArea(
          child: SingleChildScrollView(
            padding: const EdgeInsets.fromLTRB(20, 18, 20, 32),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            'Read. Discover. Understand.',
                            style: TextStyle(
                              fontSize: 13,
                              fontWeight: FontWeight.w700,
                              color: Colors.grey.shade600,
                            ),
                          ),
                          const SizedBox(height: 4),
                          const Text(
                            'Knowledge Library',
                            style: TextStyle(
                              fontSize: 29,
                              fontWeight: FontWeight.w800,
                              color: Color(0xFF183B2A),
                            ),
                          ),
                        ],
                      ),
                    ),
                    Container(
                      width: 50,
                      height: 50,
                      decoration: BoxDecoration(
                        gradient: const LinearGradient(
                          colors: [
                            Color(0xFFE8D7AE),
                            Color(0xFFF3E9D0),
                          ],
                        ),
                        borderRadius: BorderRadius.circular(17),
                        border: Border.all(
                          color: const Color(0xFFB89452).withValues(
                            alpha: 0.24,
                          ),
                        ),
                      ),
                      child: const Icon(
                        Icons.menu_book_rounded,
                        color: Color(0xFF8A632F),
                        size: 26,
                      ),
                    ),
                  ],
                ),

                const SizedBox(height: 24),

                Container(
                  width: double.infinity,
                  padding: const EdgeInsets.all(24),
                  decoration: BoxDecoration(
                    gradient: const LinearGradient(
                      colors: [
                        Color(0xFF183B2A),
                        Color(0xFF42684D),
                        Color(0xFF8A632F),
                      ],
                      begin: Alignment.topLeft,
                      end: Alignment.bottomRight,
                    ),
                    borderRadius: BorderRadius.circular(28),
                    border: Border.all(
                      color: const Color(0xFFE5CF98).withValues(
                        alpha: 0.28,
                      ),
                    ),
                    boxShadow: [
                      BoxShadow(
                        color: const Color(0xFF183B2A).withValues(
                          alpha: 0.17,
                        ),
                        blurRadius: 23,
                        offset: const Offset(0, 10),
                      ),
                    ],
                  ),
                  child: Stack(
                    children: [
                      Positioned(
                        right: -25,
                        top: -28,
                        child: Container(
                          width: 130,
                          height: 130,
                          decoration: BoxDecoration(
                            shape: BoxShape.circle,
                            border: Border.all(
                              color: const Color(0xFFE5CF98).withValues(
                                alpha: 0.12,
                              ),
                              width: 1.4,
                            ),
                          ),
                        ),
                      ),
                      Positioned(
                        right: 8,
                        top: 20,
                        child: Icon(
                          Icons.auto_stories_rounded,
                          size: 82,
                          color: const Color(0xFFE5CF98).withValues(
                            alpha: 0.08,
                          ),
                        ),
                      ),
                      Positioned(
                        right: -5,
                        bottom: -28,
                        child: Icon(
                          Icons.eco_rounded,
                          size: 92,
                          color: Colors.white.withValues(
                            alpha: 0.06,
                          ),
                        ),
                      ),
                      Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Container(
                            padding: const EdgeInsets.symmetric(
                              horizontal: 11,
                              vertical: 6,
                            ),
                            decoration: BoxDecoration(
                              color: const Color(0xFFB89452).withValues(
                                alpha: 0.16,
                              ),
                              borderRadius: BorderRadius.circular(30),
                              border: Border.all(
                                color: const Color(0xFFE5CF98).withValues(
                                  alpha: 0.20,
                                ),
                              ),
                            ),
                            child: const Text(
                              'JEEVAN SUTRA COLLECTION',
                              style: TextStyle(
                                color: Color(0xFFF3E8CD),
                                fontSize: 10.5,
                                fontWeight: FontWeight.w800,
                                letterSpacing: 1.05,
                              ),
                            ),
                          ),
                          const SizedBox(height: 18),
                          const Text(
                            'Knowledge worth\nexploring.',
                            style: TextStyle(
                              color: Colors.white,
                              fontSize: 29,
                              height: 1.12,
                              fontWeight: FontWeight.w800,
                            ),
                          ),
                          const SizedBox(height: 10),
                          Text(
                            'Discover ideas, traditions, practices, and stories that connect knowledge with everyday life.',
                            style: TextStyle(
                              color: Colors.white.withValues(
                                alpha: 0.84,
                              ),
                              fontSize: 13.5,
                              height: 1.5,
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),

                const SizedBox(height: 28),

                const Text(
                  'Explore collections',
                  style: TextStyle(
                    fontSize: 22,
                    fontWeight: FontWeight.w800,
                    color: Color(0xFF183B2A),
                  ),
                ),

                const SizedBox(height: 8),

                Text(
                  'Browse different areas of Indian knowledge through simple introductions.',
                  style: TextStyle(
                    fontSize: 13,
                    height: 1.45,
                    color: Colors.grey.shade600,
                  ),
                ),

                const SizedBox(height: 17),

                const _LibraryCard(
                  icon: Icons.health_and_safety_rounded,
                  title: 'Health & Wellness',
                  description:
                      'Explore educational ideas about everyday wellbeing, routines, rest, food, and mindful living.',
                  accent: Color(0xFF2F6B4F),
                ),

                const _LibraryCard(
                  icon: Icons.spa_rounded,
                  title: 'Ayurveda',
                  description:
                      'Learn introductory concepts connected with a traditional Indian system of knowledge and wellness.',
                  accent: Color(0xFF8A632F),
                ),

                const _LibraryCard(
                  icon: Icons.self_improvement_rounded,
                  title: 'Yoga & Philosophy',
                  description:
                      'Discover ideas around yoga, attention, awareness, and balanced living.',
                  accent: Color(0xFF765B8A),
                ),

                const _LibraryCard(
                  icon: Icons.public_rounded,
                  title: 'Indian Traditions',
                  description:
                      'Explore customs, cultural practices, festivals, and knowledge from different regions of India.',
                  accent: Color(0xFFB07832),
                ),

                const _LibraryCard(
                  icon: Icons.auto_stories_rounded,
                  title: 'Ancient Texts',
                  description:
                      'Get simple introductions to important texts and knowledge traditions from Indian history.',
                  accent: Color(0xFF547A9A),
                ),

                const SizedBox(height: 16),

                Row(
                  children: [
                    const Expanded(
                      child: Text(
                        'Featured reading',
                        style: TextStyle(
                          fontSize: 22,
