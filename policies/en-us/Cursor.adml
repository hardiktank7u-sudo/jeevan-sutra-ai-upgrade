			<presentation id="BlockExtensionInstallFromVsix"><checkBox refId="BlockExtensionInstallFromVsix">BlockExtensionInstallFromVsix</checkBox></presentation>
			<presentation id="BlockExtensionInstallFromVsixExceptions"><multiTextBox refId="BlockExtensionInstallFromVsixExceptions" /></presentation>
