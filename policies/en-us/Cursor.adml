			<presentation id="ExtensionGalleryServiceUrl"><textBox refId="ExtensionGalleryServiceUrl"><label>ExtensionGalleryServiceUrl:</label></textBox></presentation>
			<presentation id="AllowedExtensions"><multiTextBox refId="AllowedExtensions" /></presentation>
			<presentation id="DevContainersEnableSSHAgentForwarding"><checkBox refId="DevContainersEnableSSHAgentForwarding">DevContainersEnableSSHAgentForwarding</checkBox></presentation>
			<presentation id="DevContainersEnableGPGAgentForwarding"><checkBox refId="DevContainersEnableGPGAgentForwarding">DevContainersEnableGPGAgentForwarding</checkBox></presentation>
			<presentation id="DevContainersCopyGitConfig"><checkBox refId="DevContainersCopyGitConfig">DevContainersCopyGitConfig</checkBox></presentation>
			<presentation id="DevContainersDefaultExtensions"><multiTextBox refId="DevContainersDefaultExtensions" /></presentation>
		</presentationTable>
