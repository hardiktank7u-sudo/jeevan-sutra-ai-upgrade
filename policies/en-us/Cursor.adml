			<presentation id="AirlockStartContainerHook"><textBox refId="AirlockStartContainerHook"><label>AirlockStartContainerHook:</label></textBox></presentation>
			<presentation id="AirlockPreAttachContainerHook"><textBox refId="AirlockPreAttachContainerHook"><label>AirlockPreAttachContainerHook:</label></textBox></presentation>
			<presentation id="AirlockRestartContainerHook"><textBox refId="AirlockRestartContainerHook"><label>AirlockRestartContainerHook:</label></textBox></presentation>
			<presentation id="AirlockContainerStatusHook"><textBox refId="AirlockContainerStatusHook"><label>AirlockContainerStatusHook:</label></textBox></presentation>
			<presentation id="AirlockHookTimeoutSeconds"><decimalTextBox refId="AirlockHookTimeoutSeconds" defaultValue="120">AirlockHookTimeoutSeconds</decimalTextBox></presentation>
			<presentation id="DeploymentBackendUrl"><textBox refId="DeploymentBackendUrl"><label>DeploymentBackendUrl:</label></textBox></presentation>
			<presentation id="DeploymentWebsiteUrl"><textBox refId="DeploymentWebsiteUrl"><label>DeploymentWebsiteUrl:</label></textBox></presentation>
			<presentation id="AirlockRequired"><checkBox refId="AirlockRequired">AirlockRequired</checkBox></presentation>
			<presentation id="WorkspaceTrustEnabled"><checkBox refId="WorkspaceTrustEnabled">WorkspaceTrustEnabled</checkBox></presentation>
